# Rust
/target/
# Do not commit the vendored crates directory; we vendor at build-time in the
# Flatpak manifest instead. This keeps the git history small.
vendor/

# Environment variables (contains secrets)
.env

# Codegraph local index
.codegraph/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
macOS/

# Build artifacts
*.o
*.so
*.dylib

# Generated by Cargo
**/*.rs.bk

# Flatpak / flatpak-builder artifacts
# local build export repo created by flatpak-builder
/repo/
# builddir produced by flatpak-builder
/builddir/
# flatpak-builder runtime state and rofiles
/.flatpak-builder/
flatpak/source

# App export and metadata produced by flatpak-builder
/metadata
/metadata.debuginfo
/export/
/files/
/screenshots/

# Flatpak bundles and local repos
*.flatpak
flatpak/*.flatpak

# Flatpak manifest is generated from .yaml.in by scripts/render-flatpak-manifest.sh
flatpak/me.spaceinbox.actioneer.yaml

# AppStream metainfo is generated from metainfo.xml.in + po/*.po by msgfmt --xml
data/metainfo.xml
