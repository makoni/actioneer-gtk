#: data/metainfo.xml.in:6
msgid "Actioneer"
msgstr ""

#: data/metainfo.xml.in:7
msgid "Track GitHub Actions runs"
msgstr ""

#: data/metainfo.xml.in:9
msgid ""
"Actioneer lets you browse GitHub repositories, inspect workflow runs, check "
"job logs, and refresh status without leaving your desktop."
msgstr ""

#: data/metainfo.xml.in:11
msgid "Key features"
msgstr ""

#: data/metainfo.xml.in:13
msgid ""
"Browse your GitHub repositories and view Actions workflows and recent runs "
"quickly."
msgstr ""

#: data/metainfo.xml.in:14
msgid ""
"Inspect run status (success, failure, queued, in progress) with clear badges "
"and counts."
msgstr ""

#: data/metainfo.xml.in:15
msgid "Filter runs and focus on what matters most."
msgstr ""

#: data/metainfo.xml.in:16
msgid "View job logs: download and preview run logs for quick troubleshooting."
msgstr ""

#: data/metainfo.xml.in:17
msgid ""
"Dispatch workflows, cancel running workflows, and re-run failed runs "
"directly from the app."
msgstr ""

#: data/metainfo.xml.in:18
msgid ""
"Favorites and quick search let you focus on the repositories and workflows "
"that matter most."
msgstr ""

#: data/metainfo.xml.in:19
msgid ""
"Desktop notifications for run completions and failures so you never miss "
"important results."
msgstr ""

#: data/metainfo.xml.in:20
msgid "Keep recent workflow data available offline."
msgstr ""

#: data/metainfo.xml.in:21
msgid "Fast refreshes that keep the interface responsive."
msgstr ""

#: data/metainfo.xml.in:24
msgid ""
"This package contains the desktop application, icons and AppStream metadata "
"required for distribution via Flatpak/Flathub. See the project repository "
"for source code, contribution guidelines, and additional documentation."
msgstr ""

