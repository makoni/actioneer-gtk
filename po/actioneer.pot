msgid ""
"Italian and Japanese translations added; Actioneer is now available in 14 "
"languages."
msgstr ""

#: data/metainfo.xml.in:120
msgid ""
"Reviewed and completed the existing translations: every remaining "
"untranslated string is now translated in all languages, with diacritics and "
"wording corrected."
msgstr ""

