msgid ""
"The workflow detail pane was redesigned: workflows, runs, jobs, and steps "
"now expand inline in one place, without opening extra windows."
msgstr ""

#: data/metainfo.xml.in:118
msgid "Running jobs and steps now show live durations."
msgstr ""

