msgstr "ٹوکن محفوظ ہو رہا ہے..."

msgid "Set the application language (e.g., ru, en, zh_Hans)"
msgstr "ایپلیکیشن کی زبان مقرر کریں (مثلاً ru، en، zh_Hans)"

msgid "Start the app with sample demo data"
msgstr "نمونہ ڈیمو ڈیٹا کے ساتھ ایپ شروع کریں"

msgid "No repositories match"
msgstr "کوئی ریپوزٹری مماثل نہیں"

#~ msgid "Activity is gathered as you open repositories."
#~ msgstr "ریپوزٹریز کھولنے پر سرگرمی جمع کی جاتی ہے۔"

msgid "{count} workflows in this state"
msgstr "اس حالت میں {count} ورک فلو"

msgid "Try another filter or search term."
msgstr "کوئی اور فلٹر یا تلاش کی اصطلاح آزمائیں۔"
msgid "The workflow detail pane was redesigned: workflows, runs, jobs, and steps now "
"expand inline in one place, without opening extra windows."
msgstr "ورک فلو تفصیلات کے پینل کو دوبارہ ڈیزائن کیا گیا: ورک فلو، رنز، جابز اور اسٹیپس "
"اب ایک ہی جگہ پر ان لائن کھلتے ہیں، بغیر کسی اضافی ونڈو کھولے۔"

msgid "Running jobs and steps now show live durations."
msgstr "چل رہی جابز اور اسٹیپس اب لائیو مدت دکھاتی ہیں۔"

msgid "Italian and Japanese translations added; Actioneer is now available in 14 "
"languages."
msgstr "اطالوی اور جاپانی تراجم شامل کر دی گئیں؛ Actioneer اب 14 زبانوں میں دستیاب ہے۔"

msgid "Reviewed and completed the existing translations: every remaining untranslated string is now translated in all languages, with diacritics and wording corrected."
msgstr "موجود ترجمات کا جائزہ لیا اور تکمیل کی گئی: تمام باقی ماندہ غیر مترجم متن اب تمام زبانوں میں مکمل ہو گئے ہیں، علاماتِ اِظہار اور لفظی انتخاب میں بہتری کے ساتھ۔"

msgid "Updated bundled components help keep Actioneer reliable and up to date."
msgstr "اپ ڈیٹ شدہ بندلڈ اجزاء Actioneer کو قابلِ اعتماد اور تازہ رکھنے میں مدد دیتے "
"ہیں۔"

